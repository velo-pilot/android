<?xml version="1.0" encoding="utf-8"?>
<!--
	Extends the bicycle profile of routing.xml (OsmAnd-resources) with the cycle node network option, see
	RoutingConfiguration.parseDefault(). The e_bike profile extends the result, so it has the option too.

	Cycle node networks (fietsknooppunten in Belgium and the Netherlands, Knotenpunkte in Germany): numbered
	junctions with signposted routes between them, mapped as route=bicycle relations with
	network:type=node_network. OsmAnd maps (obf_creation/rendering_types.xml) store them on the ways as
	route_bicycle but turn their network=* into node_network=*, which routing does not see. So a way that is
	route_bicycle without network=* is on a node network, while long distance and regional routes (LF, icoon
	and cycle highway routes) keep network=icn/ncn/rcn/lcn. The option follows every way that is route_bicycle:
	where a node network shares a way with such a route, only the network=* of the route is left, and the long
	distance routes in Belgium and the Netherlands mostly run on the node network anyway.

	The option makes the ways off the network more expensive instead of the network cheaper: speed * priority
	is capped at maxSpeed, and the good bicycle ways already reach that cap. Ways on the network keep all the
	rules of the profile below. Ways off the network get the table below instead, which keeps the profile's
	order (cycle paths over quiet streets over main roads, paved over unpaved) but stops at the first match, so
	it has its own surface rules.
	  * prefer: a detour of up to about a third to stay on the network;
	  * strict: leave the network only to reach the start or destination, or to bridge a gap in it.
	The precalculated (HH) routes of the maps are built without the option, so it uses standard routing.

	Driving style "Leisure" (driving_style_leisure): slower but nicer routes for riding for pleasure. Signposted
	cycle routes, cycle paths, cycle streets, quiet country roads and paved tracks win; main roads are avoided
	much more than with "Safety". Its table comes after the node network tables, so with both, ways off the
	network follow the node network table and ways on it this one.
-->
<osmand_routing_config>

	<routingProfile name="bicycle" extends="bicycle">

		<!-- The group shows as one choice; node_network_off has no rules and is there to switch back -->
		<parameter id="node_network_off" group="node_network" name="Off" description="Ignore the cycle node network" type="boolean" default="true"/>
		<parameter id="node_network_prefer" group="node_network" name="Prefer" description="Prefer the cycle node network and other signposted cycle routes" type="boolean" hhRouting="false"/>
		<parameter id="node_network_strict" group="node_network" name="Stay on the network" description="Leave the cycle node network only to reach the start or destination, or where it has a gap" type="boolean" hhRouting="false"/>
		<parameter id="driving_style_leisure" group="driving_style" name="Leisure" description="Slower but nicer: cycle routes, cycle paths and quiet roads, away from main roads" type="boolean" hhRouting="false"/>

		<way attribute="priority">
			<if param="node_network_prefer">
				<ifnot t="route_bicycle">
					<select value="0.2" t="highway" v="steps"/>
					<select value="0.1" t="bicycle" v="private"/>
					<select value="0.15" t="bicycle" v="destination"/>
					<select value="0.25" t="footway" v="sidewalk"/>
					<if param="avoid_unpaved">
						<select value="0.1" t="surface" v="unpaved"/>
						<select value="0.1" t="surface" v="gravel"/>
						<select value="0.15" t="surface" v="fine_gravel"/>
						<select value="0.15" t="surface" v="compacted"/>
						<select value="0.1" t="surface" v="ground"/>
						<select value="0.1" t="surface" v="earth"/>
						<select value="0.05" t="surface" v="dirt"/>
						<select value="0.05" t="surface" v="grass"/>
						<select value="0.05" t="surface" v="sand"/>
						<select value="0.05" t="surface" v="mud"/>
						<select value="0.25" t="highway" v="track"/>
						<select value="0.15" t="highway" v="path"/>
					</if>
					<if param="avoid_sett">
						<select value="0.15" t="surface" v="sett"/>
					</if>
					<if param="avoid_cobblestone">
						<select value="0.1" t="surface" v="cobblestone"/>
						<select value="0.05" t="surface" v="unhewn_cobblestone"/>
					</if>
					<select value="0.35" t="surface" v="sand"/>
					<select value="0.35" t="surface" v="mud"/>
					<select value="0.4" t="surface" v="dirt"/>
					<select value="0.45" t="surface" v="grass"/>
					<select value="0.4" t="surface" v="unhewn_cobblestone"/>
					<select value="0.5" t="surface" v="cobblestone"/>
					<select value="0.55" t="surface" v="sett"/>
					<select value="0.55" t="surface" v="ground"/>
					<select value="0.55" t="surface" v="earth"/>
					<select value="0.6" t="surface" v="unpaved"/>
					<select value="0.65" t="surface" v="gravel"/>
					<select value="1.1" t="highway" v="cycleway"/>
					<select value="1.1" t="cycleway" v="track"/>
					<select value="1.1" t="bicycle" v="designated"/>
					<select value="1" t="cycleway" v="lane"/>
					<select value="0.9" t="highway" v="residential"/>
					<select value="0.9" t="highway" v="living_street"/>
					<select value="0.9" t="highway" v="unclassified"/>
					<select value="0.5" t="highway" v="track"/>
					<select value="0.45" t="highway" v="path"/>
					<select value="0.45" t="highway" v="footway"/>
					<select value="0.8"/>
				</ifnot>
			</if>
			<if param="node_network_strict">
				<ifnot t="route_bicycle">
					<select value="0.08" t="highway" v="steps"/>
					<select value="0.05" t="bicycle" v="private"/>
					<select value="0.08" t="bicycle" v="destination"/>
					<select value="0.1" t="footway" v="sidewalk"/>
					<if param="avoid_unpaved">
						<select value="0.04" t="surface" v="unpaved"/>
						<select value="0.04" t="surface" v="gravel"/>
						<select value="0.05" t="surface" v="fine_gravel"/>
						<select value="0.05" t="surface" v="compacted"/>
						<select value="0.04" t="surface" v="ground"/>
						<select value="0.04" t="surface" v="earth"/>
						<select value="0.02" t="surface" v="dirt"/>
						<select value="0.02" t="surface" v="grass"/>
						<select value="0.02" t="surface" v="sand"/>
						<select value="0.02" t="surface" v="mud"/>
						<select value="0.08" t="highway" v="track"/>
						<select value="0.05" t="highway" v="path"/>
					</if>
					<if param="avoid_sett">
						<select value="0.05" t="surface" v="sett"/>
					</if>
					<if param="avoid_cobblestone">
						<select value="0.04" t="surface" v="cobblestone"/>
						<select value="0.02" t="surface" v="unhewn_cobblestone"/>
					</if>
					<select value="0.12" t="surface" v="sand"/>
					<select value="0.12" t="surface" v="mud"/>
					<select value="0.14" t="surface" v="dirt"/>
					<select value="0.15" t="surface" v="grass"/>
					<select value="0.14" t="surface" v="unhewn_cobblestone"/>
					<select value="0.17" t="surface" v="cobblestone"/>
					<select value="0.18" t="surface" v="sett"/>
					<select value="0.18" t="surface" v="ground"/>
					<select value="0.18" t="surface" v="earth"/>
					<select value="0.2" t="surface" v="unpaved"/>
					<select value="0.22" t="surface" v="gravel"/>
					<select value="0.38" t="highway" v="cycleway"/>
					<select value="0.38" t="cycleway" v="track"/>
					<select value="0.38" t="bicycle" v="designated"/>
					<select value="0.35" t="cycleway" v="lane"/>
					<select value="0.32" t="highway" v="residential"/>
					<select value="0.32" t="highway" v="living_street"/>
					<select value="0.32" t="highway" v="unclassified"/>
					<select value="0.18" t="highway" v="track"/>
					<select value="0.15" t="highway" v="path"/>
					<select value="0.15" t="highway" v="footway"/>
					<select value="0.28"/>
				</ifnot>
			</if>
			<if param="driving_style_leisure">
				<select value="0.2" t="highway" v="steps"/>
				<select value="0.1" t="bicycle" v="private"/>
				<select value="0.15" t="bicycle" v="destination"/>
				<select value="0.25" t="footway" v="sidewalk"/>
				<if param="avoid_unpaved">
					<select value="0.1" t="surface" v="unpaved"/>
					<select value="0.1" t="surface" v="gravel"/>
					<select value="0.2" t="surface" v="fine_gravel"/>
					<select value="0.2" t="surface" v="compacted"/>
					<select value="0.1" t="surface" v="ground"/>
					<select value="0.1" t="surface" v="earth"/>
					<select value="0.05" t="surface" v="dirt"/>
					<select value="0.05" t="surface" v="grass"/>
					<select value="0.05" t="surface" v="sand"/>
					<select value="0.05" t="surface" v="mud"/>
					<select value="0.3" t="highway" v="track"/>
					<select value="0.2" t="highway" v="path"/>
				</if>
				<if param="avoid_sett">
					<select value="0.2" t="surface" v="sett"/>
				</if>
				<if param="avoid_cobblestone">
					<select value="0.1" t="surface" v="cobblestone"/>
					<select value="0.05" t="surface" v="unhewn_cobblestone"/>
				</if>
				<select value="0.35" t="surface" v="sand"/>
				<select value="0.35" t="surface" v="mud"/>
				<select value="0.45" t="surface" v="dirt"/>
				<select value="0.5" t="surface" v="grass"/>
				<select value="0.4" t="surface" v="unhewn_cobblestone"/>
				<select value="0.55" t="surface" v="cobblestone"/>
				<select value="0.6" t="surface" v="sett"/>
				<!-- Main roads are not what you came for, also with a cycle route or cycle track along them -->
				<select value="0.1" t="highway" v="motorway"/>
				<select value="0.1" t="highway" v="trunk"/>
				<select value="0.1" t="highway" v="trunk_link"/>
				<select value="0.3" t="highway" v="primary"/>
				<select value="0.3" t="highway" v="primary_link"/>
				<select value="0.45" t="highway" v="secondary"/>
				<select value="0.45" t="highway" v="secondary_link"/>
				<select value="0.7" t="highway" v="tertiary"/>
				<select value="0.7" t="highway" v="tertiary_link"/>
				<select value="1.6" t="route_bicycle"/>
				<select value="1.4" t="highway" v="cycleway"/>
				<select value="1.4" t="cyclestreet" v="yes"/>
				<select value="1.4" t="bicycle_road" v="yes"/>
				<select value="1.3" t="highway" v="living_street"/>
				<select value="1.3" t="tracktype" v="grade1"/>
				<select value="1.25" t="bicycle" v="designated"/>
				<select value="1.2" t="highway" v="track">
					<if t="surface" v="asphalt"/>
				</select>
				<select value="1.1" t="highway" v="track">
					<if t="surface" v="compacted"/>
				</select>
				<select value="1.1" t="highway" v="track">
					<if t="surface" v="fine_gravel"/>
				</select>
				<select value="1.05" t="highway" v="unclassified"/>
				<select value="1" t="highway" v="residential"/>
				<select value="0.9" t="highway" v="track"/>
				<select value="0.8" t="highway" v="path"/>
				<select value="0.8" t="highway" v="service"/>
				<select value="0.6" t="highway" v="footway"/>
				<select value="0.6" t="highway" v="pedestrian"/>
				<select value="0.9"/>
			</if>
		</way>

	</routingProfile>
</osmand_routing_config>
