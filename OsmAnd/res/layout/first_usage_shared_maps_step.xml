<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="horizontal"
	android:paddingHorizontal="@dimen/content_padding"
	android:paddingTop="@dimen/content_padding">

	<FrameLayout
		android:layout_width="32dp"
		android:layout_height="32dp"
		android:layout_marginEnd="@dimen/content_padding"
		android:background="@drawable/bg_circle">

		<net.osmand.plus.widgets.TextViewEx
			android:id="@+id/step_number"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center"
			android:textColor="?attr/active_color_basic"
			android:textSize="@dimen/default_list_text_size"
			app:typefaceWeight="medium"
			tools:text="1" />

		<androidx.appcompat.widget.AppCompatImageView
			android:id="@+id/step_done"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:scaleType="center"
			android:visibility="gone"
			app:srcCompat="@drawable/ic_action_done"
			app:tint="?attr/active_color_basic" />

	</FrameLayout>

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/step_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textAppearance="@style/TextAppearance.ListItemTitle"
			android:textColor="?android:textColorPrimary"
			tools:text="@string/shared_osmand_maps_step_access" />

		<TextView
			android:id="@+id/step_description"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/content_padding_small_half"
			android:textColor="?android:textColorSecondary"
			android:textSize="@dimen/default_desc_text_size"
			tools:text="@string/shared_osmand_maps_step_access_descr" />

		<net.osmand.plus.widgets.dialogbutton.DialogButton
			android:id="@+id/step_button"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:dialogButtonTopMargin="@dimen/content_padding_small"
			app:dialogButtonHeight="@dimen/dialog_button_height"
			app:dialogButtonType="secondary"
			tools:dialogButtonTitle="@string/shared_osmand_maps_allow_access" />

	</LinearLayout>

</LinearLayout>
