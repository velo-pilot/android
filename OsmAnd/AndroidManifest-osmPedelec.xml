<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets Android grant read access to the obb folder of the OsmAnd app, so that its maps can be
         used without downloading them again (SharedMapsHelper). This app does not install packages. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:icon="@mipmap/icon_osmpedelec"
        tools:replace="android:icon">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            tools:replace="android:authorities"/>
    </application>
</manifest>
